# ====================================================================
# Fin Mind — Environment Configuration
# ====================================================================
# Copy this file to `.env`:
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# ====================================================================

# Required: Google Gemini API Key for LLM reasoning and multi-agent workflow
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# Optional: JWT signing secret (defaults to internal dev key if omitted)
SECRET_KEY="temporary-dev-jwt-secret-key-change-in-prod"
